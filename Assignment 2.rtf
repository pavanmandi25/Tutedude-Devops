\pard\sa200\sl276\slmult1\par
2. Student Grades\line students = \{\}\par
\par
while True:\par
    print("\\n1. Add Student")\par
    print("2. Update Student Grade")\par
    print("3. Display All Students")\par
    print("4. Exit")\par
\par
    choice = input("Enter your choice: ")\par
\par
    if choice == "1":\par
        name = input("Enter student name: ")\par
        grade = input("Enter grade: ")\par
        students[name] = grade\par
        print("Student added successfully.")\par
\par
    elif choice == "2":\par
        name = input("Enter student name: ")\par
        if name in students:\par
            grade = input("Enter new grade: ")\par
            students[name] = grade\par
            print("Grade updated successfully.")\par
        else:\par
            print("Student not found.")\par
\par
    elif choice == "3":\par
        print("\\nStudent Grades:")\par
        for name, grade in students.items():\par
            print(name, ":", grade)\par
\par
    elif choice == "4":\par
        print("Exiting program...")\par
        break\par
\par
    else:\par
        print("Invalid choice.")\par

